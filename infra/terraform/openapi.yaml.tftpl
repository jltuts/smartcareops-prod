swagger: "2.0"
info:
  title: SmartCareOps DEV health baseline
  version: "1.0.0"
schemes: [https]
produces: [application/json]
x-google-allow: configured
x-google-backend:
  address: ${backend_url}
  jwt_audience: ${backend_url}
  path_translation: APPEND_PATH_TO_ADDRESS
  deadline: 15.0
# Public health metadata only. Never publish patient/clinical routes without auth.
paths:
  /health:
    get:
      operationId: health
      responses:
        "200":
          description: API process is serving HTTP
  /readyz:
    get:
      operationId: readyz
      responses:
        "200":
          description: Cached startup Firestore read and secret presence checks passed
        "503":
          description: Required startup dependencies are not ready
%{ if enable_auth_routes ~}
  /api/auth/me:
    get:
      operationId: authenticatedIdentity
      responses:
        "200":
          description: Backend-verified Firebase identity and server-owned DEV access
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Origin not allowed
    options:
      operationId: identityCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/regional:
    get:
      operationId: readRegionalIntelligence
      responses:
        "200":
          description: Fictional regional evidence and operational assessment
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Command Center role required
    options:
      operationId: regionalReadCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/operations:
    get:
      operationId: readHospitalOperations
      responses:
        "200":
          description: Fictional hospital operations evidence and plans
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Command Center role required
    options:
      operationId: operationsReadCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/operations/capacity:
    post:
      operationId: changeHospitalOperationsCapacity
      responses:
        "200":
          description: Record a fictional HOSP-001 monitored-bed capacity change
        "400":
          description: Invalid capacity command
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Command Center role or exact Origin required
        "409":
          description: Capacity version is stale or request conflicts
    options:
      operationId: operationsCapacityCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/operations/run:
    post:
      operationId: requestHospitalOperationsAssessment
      responses:
        "200":
          description: Request a bounded fictional Hospital Operations assessment
        "400":
          description: Invalid assessment request
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Command Center role or exact Origin required
    options:
      operationId: operationsRunCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/operations/reset:
    post:
      operationId: resetHospitalOperationsDemo
      responses:
        "200":
          description: Reset only the fictional HOSP-001 capacity scenario and bounded assessment budget
        "400":
          description: Invalid reset request
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Command Center role or exact Origin required
        "409":
          description: An assessment is currently active
    options:
      operationId: operationsResetCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/operations/approvals/{approvalId}:
    parameters:
      - name: approvalId
        in: path
        required: true
        type: string
    post:
      operationId: decideHospitalOperationsAction
      responses:
        "200":
          description: Record an approved or rejected fictional Operations action
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Command Center role or exact Origin required
        "409":
          description: Approval is stale, expired, superseded, or already decided
    options:
      operationId: operationsApprovalCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/operations/demo-verify:
    post:
      operationId: verifyRoutineIntakeBoundary
      responses:
        "200":
          description: Sanitized event-boundary trace for a supplied fictional case ID
        "400":
          description: Invalid case ID
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Command Center role or exact Origin required
    options:
      operationId: operationsDemoVerifyCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
%{ if enable_m43_gateway_routes ~}
  /api/operations/emergency-responses:
    get:
      operationId: readEmergencyResponseSummary
      responses:
        "200":
          description: Read-only fictional emergency and ambulance aggregate
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Command Center role or exact Origin required
    options:
      operationId: emergencyResponseSummaryCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
%{ endif ~}
  /api/notifications/appointments:
    get:
      operationId: readOwnAppointmentNotifications
      parameters:
        - name: recipientType
          in: query
          required: true
          type: string
      responses:
        "200":
          description: UID-scoped fictional appointment notices for Patient or Doctor
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Role or exact Origin required
    options:
      operationId: appointmentNotificationsCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/notifications/cases:
    get:
      operationId: readAuthorizedCaseNotifications
      parameters:
        - name: recipientType
          in: query
          required: true
          type: string
      responses:
        "200":
          description: Role and case-scoped fictional in-app notices
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Role or case access denied
    options:
      operationId: caseNotificationsCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/notifications:
    get:
      operationId: readOperationalNotifications
      parameters:
        - name: recipientType
          in: query
          required: false
          type: string
      responses:
        "200":
          description: Fictional durable operational notifications and receipts
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Command Center role required
    options:
      operationId: notificationsReadCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
%{ endif ~}
%{ if enable_m15 ~}
  /api/simulation:
    get:
      operationId: readSyntheticNetworkSimulation
      responses:
        "200":
          description: Synthetic Command Center healthcare network snapshot
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Command Center role required
    options:
      operationId: simulationReadCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/simulation/advance:
    post:
      operationId: advanceSyntheticNetworkSimulation
      consumes: [application/json]
      responses:
        "200":
          description: Advance the deterministic simulation by a bounded number of ticks
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Command Center role required
    options:
      operationId: simulationAdvanceCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/simulation/scenario:
    post:
      operationId: selectSyntheticNetworkScenario
      consumes: [application/json]
      responses:
        "200":
          description: Reset simulation to a known scenario starting state
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Command Center role required
    options:
      operationId: simulationScenarioCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/simulation/reset:
    post:
      operationId: resetSyntheticNetworkSimulation
      consumes: [application/json]
      responses:
        "200":
          description: Restore the selected scenario's deterministic initial state
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Command Center role required
    options:
      operationId: simulationResetCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
%{ endif ~}
%{ if enable_m16 ~}
  /api/caretwin:
    get:
      operationId: readCareTwinPlan
      responses:
        "200":
          description: Persisted simulated futures and advisory CareTwin recommendation
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Command Center role required
    options:
      operationId: careTwinReadCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/caretwin/generate:
    post:
      operationId: generateCareTwinPlans
      consumes: [application/json]
      responses:
        "200":
          description: Simulate exactly three plans from one M15 baseline and compare the outcomes
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Command Center role or exact Origin required
    options:
      operationId: careTwinGenerateCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/caretwin/decision:
    post:
      operationId: decideCareTwinRecommendation
      consumes: [application/json]
      responses:
        "200":
          description: Persist an advisory Approve, Reject, or Defer decision; no execution occurs
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Command Center role or exact Origin required
    options:
      operationId: careTwinDecisionCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
%{ endif ~}
%{ if enable_m17 ~}
  /api/predictive:
    get:
      operationId: readPersistedPredictiveForecast
      responses:
        "200":
          description: Persisted deterministic M15 forecast and advisory interpretation
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Command Center role required
    options:
      operationId: predictiveReadCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/predictive/generate:
    post:
      operationId: generatePredictiveForecast
      consumes: [application/json]
      responses:
        "200":
          description: Project independent 30, 60, and 120 minute M15 trajectories and interpret them
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Command Center role or exact Origin required
    options:
      operationId: predictiveGenerateCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
%{ endif ~}
%{ if enable_m18 ~}
  /api/patterns:
    get:
      operationId: readSyntheticPatternAlert
      responses:
        "200":
          description: Persisted safe aggregate alert state; no patient-level data
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Command Center role required
    options:
      operationId: patternReadCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/patterns/refresh:
    post:
      operationId: refreshSyntheticPatternDetection
      consumes: [application/json]
      responses:
        "200":
          description: Deterministic respiratory aggregate scan and persisted alert
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Command Center role or exact Origin required
    options:
      operationId: patternRefreshCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/patterns/acknowledge:
    post:
      operationId: acknowledgeSyntheticPatternAlert
      consumes: [application/json]
      responses:
        "200":
          description: Acknowledge current pattern alert for the verified staff UID
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Command Center role or exact Origin required
        "409":
          description: Alert is no longer current
    options:
      operationId: patternAcknowledgeCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
%{ endif ~}
%{ if enable_hosted_live ~}
  /api/doctor/application:
    post:
      operationId: submitDoctorProfileApplication
      consumes: [application/json]
      responses:
        "200":
          description: Submit a pending Doctor profile application; does not grant Doctor access
        "400":
          description: Invalid profile application
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Exact allowed Origin required
    options:
      operationId: doctorApplicationCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/patient/application:
    post:
      operationId: submitPatientPortalAccessApplication
      consumes: [application/json]
      responses:
        "200":
          description: Submit a Patient access request without starting an intake
        "400":
          description: Invalid application request
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Exact allowed Origin required
    options:
      operationId: patientApplicationCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/admin/doctor-applications:
    get:
      operationId: listPendingDoctorApplications
      parameters:
        - { name: limit, in: query, required: false, type: integer, minimum: 1, maximum: 50, default: 25 }
        - { name: cursor, in: query, required: false, type: string, minLength: 1, maxLength: 128 }
      responses:
        "200":
          description: Admin-only minimal queue of pending Doctor applications
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Admin role required
    options:
      operationId: adminDoctorApplicationsCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/admin/approved-doctors:
    get:
      operationId: listApprovedDoctors
      parameters:
        - { name: limit, in: query, required: false, type: integer, minimum: 1, maximum: 50, default: 25 }
        - { name: cursor, in: query, required: false, type: string, minLength: 1, maxLength: 128 }
      responses:
        "200":
          description: Admin-only directory of approved and verified Doctors
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Admin role required
    options:
      operationId: approvedDoctorsCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/admin/approved-doctors/{uid}/specialties/{specialty}:
    delete:
      operationId: removeApprovedDoctorSpecialty
      consumes: [application/json]
      parameters:
        - { name: uid, in: path, required: true, type: string, minLength: 1, maxLength: 128 }
        - { name: specialty, in: path, required: true, type: string, enum: [general_medicine, cardiology, pulmonology, neurology, endocrinology, orthopedics] }
        - { name: Idempotency-Key, in: header, required: true, type: string, minLength: 16, maxLength: 128 }
        - name: body
          in: body
          required: true
          schema:
            type: object
            additionalProperties: false
            required: [expectedSpecialties, confirmed]
            properties:
              expectedSpecialties:
                type: array
                minItems: 1
                uniqueItems: true
                items: { type: string, enum: [general_medicine, cardiology, pulmonology, neurology, endocrinology, orthopedics] }
              confirmed: { type: boolean, enum: [true] }
      responses:
        "200":
          description: One verified specialty removed; final removal also removes Doctor Portal access
        "400":
          description: Invalid or unverified specialty removal request
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Admin role or exact allowed Origin required
        "409":
          description: Doctor specialties changed before removal
    options:
      operationId: removeApprovedDoctorSpecialtyCorsPreflight
      parameters:
        - { name: uid, in: path, required: true, type: string }
        - { name: specialty, in: path, required: true, type: string }
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/admin/patient-applications:
    get:
      operationId: listPendingPatientApplications
      parameters:
        - { name: limit, in: query, required: false, type: integer, minimum: 1, maximum: 50, default: 25 }
        - { name: cursor, in: query, required: false, type: string, minLength: 1, maxLength: 128 }
      responses:
        "200":
          description: Admin-only minimal queue of pending Patient access applications
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Admin role required
    options:
      operationId: adminPatientApplicationsCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/admin/doctor-applications/{uid}/decision:
    post:
      operationId: reviewDoctorApplication
      parameters:
        - name: uid
          in: path
          required: true
          type: string
        - { name: Idempotency-Key, in: header, required: true, type: string, minLength: 16, maxLength: 128 }
        - name: body
          in: body
          required: true
          schema:
            type: object
            additionalProperties: false
            required: [decision, applicationVersion, confirmed]
            properties:
              decision: { type: string, enum: [approved, rejected] }
              applicationVersion: { type: integer, minimum: 1 }
              confirmed: { type: boolean, enum: [true] }
              independentlyVerified: { type: boolean }
      consumes: [application/json]
      responses:
        "200":
          description: Doctor application approved after explicit credential verification or rejected
        "400":
          description: Invalid review request
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Admin role or exact allowed Origin required
        "409":
          description: Application is no longer pending
    options:
      operationId: adminDoctorApplicationDecisionCorsPreflight
      parameters:
        - name: uid
          in: path
          required: true
          type: string
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/admin/patient-applications/{uid}/decision:
    parameters:
      - name: uid
        in: path
        required: true
        type: string
    post:
      operationId: reviewPatientApplication
      consumes: [application/json]
      parameters:
        - { name: Idempotency-Key, in: header, required: true, type: string, minLength: 16, maxLength: 128 }
        - name: body
          in: body
          required: true
          schema:
            type: object
            additionalProperties: false
            required: [decision, applicationVersion, confirmed]
            properties:
              decision: { type: string, enum: [approved, rejected] }
              applicationVersion: { type: integer, minimum: 1 }
              confirmed: { type: boolean, enum: [true] }
      responses:
        "200":
          description: Admin approves or rejects access to the Patient Portal
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Admin role or exact allowed Origin required
        "409":
          description: Application is no longer pending
    options:
      operationId: adminPatientApplicationDecisionCorsPreflight
      parameters:
        - name: uid
          in: path
          required: true
          type: string
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/admin/settings:
    get:
      operationId: readAdminSettings
      responses:
        "200":
          description: Admin reads Patient Portal access mode
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Admin role required
    options:
      operationId: adminSettingsCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/admin/settings/patient-access:
    put:
      operationId: updatePatientPortalAccessMode
      consumes: [application/json]
      parameters:
        - { name: Idempotency-Key, in: header, required: true, type: string, minLength: 16, maxLength: 128 }
        - name: body
          in: body
          required: true
          schema:
            type: object
            additionalProperties: false
            required: [mode, expectedVersion, confirmed]
            properties:
              mode: { type: string, enum: [open, approved_only] }
              expectedVersion: { type: integer, minimum: 1 }
              confirmed: { type: boolean, enum: [true] }
      responses:
        "200":
          description: Persist Patient Portal open or approved-only access policy
        "400":
          description: Invalid access mode
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Admin role or exact allowed Origin required
    options:
      operationId: updatePatientPortalAccessModeCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/admin/purge-preview:
    get:
      operationId: previewSmartCareOpsTestDataPurge
      x-google-backend:
        address: ${backend_url}
        jwt_audience: ${backend_url}
        path_translation: APPEND_PATH_TO_ADDRESS
        deadline: 60.0
      responses:
        "200":
          description: Counts of SmartCareOps demo records included in the purge
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Admin role required
    options:
      operationId: previewSmartCareOpsTestDataPurgeCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/admin/purge:
    post:
      operationId: purgeSmartCareOpsTestData
      x-google-backend:
        address: ${backend_url}
        jwt_audience: ${backend_url}
        path_translation: APPEND_PATH_TO_ADDRESS
        deadline: 240.0
      consumes: [application/json]
      parameters:
        - { name: Idempotency-Key, in: header, required: true, type: string, minLength: 16, maxLength: 128 }
        - name: body
          in: body
          required: true
          schema:
            type: object
            additionalProperties: false
            required: [confirmation, previewId]
            properties:
              confirmation: { type: string, enum: [PURGE ALL TEST DATA] }
              previewId: { type: string, minLength: 36, maxLength: 36 }
      responses:
        "200":
          description: Previewed SmartCareOps Firestore test records deleted; Admin profile and access policy retained
        "400":
          description: Required typed purge confirmation is invalid
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Admin role or exact allowed Origin required
        "409":
          description: Preview expired or observed data version changed
        "503":
          description: Retryable or partial purge failure with a sanitized audit receipt
    options:
      operationId: purgeSmartCareOpsTestDataCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/profile:
    get:
      operationId: readOwnProfile
      responses:
        "200":
          description: Firebase-authenticated caller reads their own backend-owned profile
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Origin not allowed or account inactive
    patch:
      operationId: updateOwnProfile
      consumes: [application/json]
      responses:
        "200":
          description: Allowlisted profile fields updated for the verified Firebase UID
        "400":
          description: Invalid or protected profile field
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Origin not allowed or account inactive
    options:
      operationId: profileCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/live/session:
    post:
      operationId: createLiveSession
      responses:
        "201":
          description: Short-lived one-time opaque Live session
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Patient role or exact Origin required
    options:
      operationId: liveSessionCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/intake/voice/complete:
    post:
      operationId: completePatientVoiceIntake
      x-google-backend:
        address: ${backend_url}
        jwt_audience: ${backend_url}
        path_translation: APPEND_PATH_TO_ADDRESS
        deadline: 60.0
      consumes: [application/json]
      parameters:
        - name: Idempotency-Key
          in: header
          required: true
          type: string
      responses:
        "200":
          description: Completed UID-owned voice intake saved under its preassigned case ID
        "400":
          description: Invalid completion payload
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Patient role or exact Origin required
        "409":
          description: Voice session unavailable or emergency evidence not validated
        "503":
          description: Intake extraction or persistence temporarily unavailable
    options:
      operationId: patientVoiceCompletionCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/intake/chat/session:
    get:
      operationId: restoreOwnedPatientChatIntake
      responses:
        "200":
          description: Active UID-owned typed intake state
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Patient role or exact Origin required
        "404":
          description: Chat session missing or owned by another Patient
    post:
      operationId: createPatientChatIntake
      consumes: [application/json]
      responses:
        "201":
          description: New or resumed UID-owned typed intake
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Patient role or exact Origin required
    delete:
      operationId: cancelOwnedPatientChatIntake
      responses:
        "200":
          description: Active typed intake cancelled without case creation
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Patient role or exact Origin required
    options:
      operationId: patientChatSessionCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/intake/chat/message:
    post:
      operationId: submitPatientChatAnswer
      consumes: [application/json]
      parameters:
        - name: Idempotency-Key
          in: header
          required: true
          type: string
      responses:
        "200":
          description: Accepted answer and next backend-authorized intake state
        "400":
          description: Invalid message shape or length
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Patient role, ownership, or exact Origin required
        "409":
          description: Stale revision, duplicate conflict, or message already processing
        "429":
          description: Bounded per-session message rate exceeded
    options:
      operationId: patientChatMessageCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
  /api/intake/medicine/scan:
    post:
      operationId: scanPatientMedicinePackaging
      consumes: [application/json]
      responses:
        "200":
          description: Patient-authorized still-image label reading; image bytes are not retained
        "401":
          description: Missing or invalid Firebase ID token
        "403":
          description: Patient role or exact Origin required
        "409":
          description: Server-owned active intake required
        "413":
          description: Image exceeds the bounded server limit
        "429":
          description: Medicine scan rate limit reached
    options:
      operationId: medicineScanCorsPreflight
      responses:
        "204":
          description: Exact allowed-origin CORS response from backend
