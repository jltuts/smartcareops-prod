# Deny by default: only runtime source and locked dependency manifests enter context.
**
!backend/
!backend/Dockerfile
!backend/package.json
!backend/package-lock.json
!backend/src/
!backend/src/**
!agent-runtime/
!agent-runtime/clinical-shadow/
!agent-runtime/clinical-shadow/Dockerfile
!agent-runtime/clinical-shadow/package.json
!agent-runtime/clinical-shadow/package-lock.json
!agent-runtime/clinical-shadow/*.js
!agent-runtime/clinical-shadow/policy/
!agent-runtime/clinical-shadow/policy/*.json
!shared/
!shared/**
# Explicit exclusions remain effective inside the allowed source directories.
**/node_modules/**
**/.git/**
**/.env*
**/*.tfstate*
**/*.tfplan*
**/*credential*
**/*service-account*.json
**/*service_account*.json
**/*.pem
**/*.key
**/tests/**
**/test-results/**
**/playwright-report/**
**/screenshots/**
**/*.png
**/*.jpg
**/*.log
**/tmp/**
**/temp/**
