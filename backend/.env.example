# Configure process variables explicitly; this file is not loaded automatically.
# Development-only inspection. Never expose local-demo auth as a public service.
APP_ENV=development
AUTH_MODE=local-demo
CASE_STORE=memory
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_INTAKE_MODEL=gemini-3.6-flash
FIREBASE_PROJECT_ID=
DEV_AUTH_UIDS=
DEV_PATIENT_UIDS=
M8_ENABLED=false
M9_ENABLED=false
M10_ENABLED=false
M11_ENABLED=false
M12_ENABLED=false
RESOURCE_MODE=simulation
MAPS_MODE=simulation
HOSPITAL_HANDOFF_CONNECTOR=rest
