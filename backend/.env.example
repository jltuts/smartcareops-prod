GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_INTAKE_MODEL=gemini-3.6-flash
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# M3: fresh isolated browser; false shows the local demo browser.
COMPUTER_USE_HEADLESS=false
# Optional installed browser channel: msedge or chrome. Empty uses Playwright Chromium.
COMPUTER_USE_BROWSER_CHANNEL=

# M4: server-side only. Firestore is the default; memory is explicit dev fallback.
APP_ENV=development
CASE_STORE=firestore
FIREBASE_PROJECT_ID=gen-lang-client-0710663107
# DEV display name: smartcareops-dev; database: (default); region: asia-southeast1.
# DEV uses local ADC: gcloud auth application-default login.
# Future PROD uses a separate project and Cloud Run service identity; not configured yet.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

# M8: opt-in DEV clinical review; doctor can select a submitted fictional case.
# M8_CASE_ID optionally retains a fixed historical workspace. No real clinical action.
M8_ENABLED=false
M8_CASE_ID=
GEMINI_CLINICAL_MODEL=gemini-3.6-flash

# M9: requires M8; fictional resources only. No Maps credentials required.
M9_ENABLED=false
RESOURCE_MODE=simulation
MAPS_MODE=simulation
# M10 single-hospital operations (DEV only; requires explicit fictional member enrollment)
M10_ENABLED=false
# M11 regional intelligence, DEV-only fictional aggregate data
M11_ENABLED=false
# M12 local-only simulated notifications; set a fictional clinical case scope explicitly
M12_ENABLED=false
M12_CLINICAL_CASE_ID=

# Hospital handoff: doctor approval required. REST targets the fictional local API.
# Explicit legacy fallback only: computer_use. Never auto-fallback on REST error.
HOSPITAL_HANDOFF_CONNECTOR=rest

# Production always requires verified Firebase Google identities for /api/*.
# Optional local auth testing: AUTH_MODE=firebase (local demo otherwise unchanged).
AUTH_MODE=local-demo
# Explicit approved Firebase UIDs only; never infer privileges from an email domain.
# Empty means authenticated users get identity only, no clinical/demo API access.
DEV_AUTH_UIDS=
# Comma-separated verified Firebase UIDs with Patient Portal access only.
DEV_PATIENT_UIDS=
