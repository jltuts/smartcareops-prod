# Configure process variables explicitly; this file is not loaded automatically.
# Development-only inspection. Never expose local-demo auth as a public service.
APP_ENV=development
AUTH_MODE=local-demo
CASE_STORE=memory
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_INTAKE_MODEL=gemini-3.6-flash
FIREBASE_PROJECT_ID=
DEV_AUTH_UIDS=
DEV_PATIENT_UIDS=
# Firebase UIDs with Admin access. Purge always retains these profiles.
ADMIN_UIDS=
# Exact Google Firebase Authentication emails retained by purge.
PURGE_PROTECTED_GOOGLE_EMAILS=johnlouisgarcia@gmail.com,chebulay.12@gmail.com

# Optional hackathon demo username/password provider. Keep generated JSON out of source control.
# Generate it with: npm --prefix backend run generate:demo-auth
DEMO_LOCAL_AUTH_ENABLED=false
DEMO_LOCAL_AUTH_CONFIG=
M8_ENABLED=false
M9_ENABLED=false
M10_ENABLED=false
M11_ENABLED=false
M12_ENABLED=false
RESOURCE_MODE=simulation
MAPS_MODE=simulation
HOSPITAL_HANDOFF_CONNECTOR=rest
